APP_NAME=CRM
# Production defaults. For a local dev box: APP_ENV=local, APP_DEBUG=true (never in
# production: debug error pages show configuration, including secrets).
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/London
# The address people open, e.g. http://192.168.1.20:8000
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# docker-compose.yml overrides DB_HOST to "mysql" (the database container).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_kbp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=atifqadeer26@gmail.com
MAIL_PASSWORD='wdzmbxhbkhpmimzb'
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=atifqadeer26@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# docker-compose MySQL root password (required by docker-compose.yml; never commit the real one)
DB_ROOT_PASSWORD=

# ── Xplogent (AI phone agent), see docs/xplogent-api.md ─────────────────────
# Shared secret (>= 32 random characters), the same as XPLOGENT_CRM_API_TOKEN on the Xplogent server.
XPLOGENT_API_TOKEN=
# users.id printed by: php artisan xplogent:make-ai-user
XPLOGENT_AI_USER_ID=
# Xplogent's address for the Agent call page: its LAN address, e.g. http://192.168.1.30:8765
# (Xplogent shows the right one under Calls -> Call agent -> CRM). Check: php artisan xplogent:check
XPLOGENT_BASE_URL=
XPLOGENT_SHARE_CLIENT_NAME=false
XPLOGENT_SHARE_CV_EXCERPT=false
XPLOGENT_MAX_SKEW=300
XPLOGENT_TIMEZONE=Europe/London
